# Pinned backend image tag for ORIN deploys.
# Example: v0.0.2
HEALTHDELTA_BACKEND_IMAGE_TAG=v0.0.2

# Published bind host for the backend port.
# Keep 127.0.0.1 for host-local only access, or set 0.0.0.0 to allow LAN clients
# such as tethered iPhones to reach the upload API.
HEALTHDELTA_PUBLISHED_BIND_HOST=127.0.0.1

# Optional local Ollama runtime for refined iPhone insight cards.
# Leave empty to disable LLM refinement.
# If Ollama is loopback-only on the ORIN host, expose a small proxy listener such as
# `socat TCP-LISTEN:11435,bind=0.0.0.0,fork,reuseaddr TCP:127.0.0.1:11434`
# and point the backend container at that listener.
HEALTHDELTA_OLLAMA_BASE_URL=
HEALTHDELTA_OLLAMA_MODEL=llama3.2:latest
HEALTHDELTA_OLLAMA_TIMEOUT_S=20
HEALTHDELTA_OLLAMA_NUM_GPU=0
