# Pinned backend image tag for ORIN deploys.
# Example: v0.0.2
HEALTHDELTA_BACKEND_IMAGE_TAG=v0.0.2

# Published bind host for the backend port.
# Keep 127.0.0.1 for host-local only access, or set 0.0.0.0 to allow LAN clients
# such as tethered iPhones to reach the upload API.
HEALTHDELTA_PUBLISHED_BIND_HOST=127.0.0.1
