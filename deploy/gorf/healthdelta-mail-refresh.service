[Unit]
Description=HealthDelta full baseline refresh from Drive to mail

[Service]
Type=oneshot
WorkingDirectory=%h/Code/HealthDelta
Environment=PYTHONPATH=%h/Code/HealthDelta/.mail-refresh-python:%h/Code/HealthDelta
ExecStartPre=/bin/bash -lc 'cd "$HOME/Code/HealthDelta" && if [ ! -e .mail-refresh-python/duckdb/__init__.py ]; then python3 -m pip install --target .mail-refresh-python "duckdb>=1.0.0,<2.0.0"; fi'
ExecStart=/usr/bin/python3 scripts/mail_drive_refresh.py --drive-source gdrive:HEALTH/Exports --work-root %h/private/healthdelta_mail_refresh --repo-root %h/Code/HealthDelta --state-json %h/private/healthdelta_mail_refresh/state.json --python-bin /usr/bin/python3 --mail-host mail --mail-data-root /opt/healthdelta/data --verify-base-url http://127.0.0.1:8080 --exclude-member export_cda.xml
